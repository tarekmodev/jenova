# Jenova local development environment.
# Copy to .env (gitignored) and fill in the supplier blocks from Tarek's
# test-credentials list. Secrets live ONLY in .env / the deployment secret store.

# --- API process (apps/api) -------------------------------------------------
# NODE_ENV defaults to development; API_PORT to 3000.
NODE_ENV=development
API_PORT=3000

# --- Control plane (docker-compose postgres) --------------------------------
# Owner credentials: migrations, provisioning, fan-out ONLY — never the request path.
CONTROL_PLANE_DATABASE_URL=postgres://jenova:jenova@localhost:5432/jenova_control_plane

# Least-privilege runtime credentials for the tenant resolver (server-level;
# the database name is swapped per tenant). Must authenticate as a LOGIN
# member of the jenova_runtime role — see packages/db/README.md. Create one
# locally with:
#   create role jenova_app login password 'jenova_app' in role jenova_runtime;
JENOVA_TENANT_RUNTIME_DSN=postgres://jenova_app:jenova_app@localhost:5432/postgres

# Server-side HMAC-SHA256 key behind every offer's signed price hash
# (CLAUDE.md rule 8) — at least 32 characters of real entropy, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ROTATION: one active key. Rotating invalidates every outstanding offer
# token (verification fails, shoppers re-search); offers live for minutes,
# so rotate any time — it costs a brief re-search window, never money.
OFFER_SIGNING_KEY=dev-only-offer-signing-key-change-me-0000

# Hard total budget for one hotel search fan-out, in milliseconds
# (docs/02-architecture.md: ~8s hotels). Optional; defaults to 8000.
HOTEL_SEARCH_BUDGET_MS=8000

# --- Cache / queues (docker-compose redis) ----------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (docker-compose minio, S3-compatible) -------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-south-1
S3_ACCESS_KEY_ID=jenova
S3_SECRET_ACCESS_KEY=jenova-minio
S3_BUCKET=jenova-dev
S3_FORCE_PATH_STYLE=true

# --- Outbound mail (docker-compose mailpit; UI at http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025

# ============================================================================
# Supplier sandbox credentials
#
# Filled from Tarek's supplier test-credentials list — leave empty until then.
# Development runs against LIVE supplier sandboxes; automated tests replay
# recorded traffic via @jenova/sandbox-replay. CI NEVER needs these values
# (look-to-book is a commercial obligation — CI never hits live sandboxes).
# Exact variable names are finalized when each adapter package lands (M1+).
# ============================================================================

# --- TBO (hotel sandbox) ----------------------------------------------------
TBO_HOTEL_API_URL=
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=

# --- RateHawk (hotel sandbox) -----------------------------------------------
RATEHAWK_API_URL=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=

# --- Hotelbeds (hotel + transfers + activities sandbox) ---------------------
HOTELBEDS_API_URL=
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=

# --- Air consolidator (Mystifly or TBO Air — per consolidator choice) -------
AIR_CONSOLIDATOR_API_URL=
AIR_CONSOLIDATOR_USERNAME=
AIR_CONSOLIDATOR_PASSWORD=
