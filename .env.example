# Jenova local development environment.
# Copy to .env (gitignored) and fill in the supplier blocks from Tarek's
# test-credentials list. Secrets live ONLY in .env / the deployment secret store.

# --- Control plane (docker-compose postgres) --------------------------------
CONTROL_PLANE_DATABASE_URL=postgres://jenova:jenova@localhost:5432/jenova_control_plane

# --- Cache / queues (docker-compose redis) ----------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (docker-compose minio, S3-compatible) -------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-south-1
S3_ACCESS_KEY_ID=jenova
S3_SECRET_ACCESS_KEY=jenova-minio
S3_BUCKET=jenova-dev
S3_FORCE_PATH_STYLE=true

# --- Outbound mail (docker-compose mailpit; UI at http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025

# ============================================================================
# Supplier sandbox credentials
#
# Filled from Tarek's supplier test-credentials list — leave empty until then.
# Development runs against LIVE supplier sandboxes; automated tests replay
# recorded traffic via @jenova/sandbox-replay. CI NEVER needs these values
# (look-to-book is a commercial obligation — CI never hits live sandboxes).
# Exact variable names are finalized when each adapter package lands (M1+).
# ============================================================================

# --- TBO (hotel sandbox) ----------------------------------------------------
TBO_HOTEL_API_URL=
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=

# --- RateHawk (hotel sandbox) -----------------------------------------------
RATEHAWK_API_URL=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=

# --- Hotelbeds (hotel + transfers + activities sandbox) ---------------------
HOTELBEDS_API_URL=
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=

# --- Air consolidator (Mystifly or TBO Air — per consolidator choice) -------
AIR_CONSOLIDATOR_API_URL=
AIR_CONSOLIDATOR_USERNAME=
AIR_CONSOLIDATOR_PASSWORD=
